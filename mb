#!/usr/bin/env bash
cd "$(dirname "$0")" || exit 1
PORT=8080
LOG=backend.log

status() {
  if lsof -ti:$PORT > /dev/null 2>&1; then
    echo "✓ HIDUP (pid $(lsof -ti:$PORT | tr '\n' ' '))"; return 0
  else
    echo "✗ MATI"; return 1
  fi
}

stop() {
  if lsof -ti:$PORT > /dev/null 2>&1; then
    lsof -ti:$PORT | xargs kill -9 2>/dev/null; sleep 2; echo "✓ dihentikan"
  else
    echo "  (memang tak hidup)"
  fi
}

start() {
  if lsof -ti:$PORT > /dev/null 2>&1; then
    echo "⚠️  port $PORT sudah diguna — jalankan './mb restart'"; return 1
  fi
  [ -z "$MONTHLEY_RESEND_KEY" ] && echo "ℹ️  MONTHLEY_RESEND_KEY tidak ditetapkan — e-mel di-log sahaja."
  echo "→ menghidupkan…"
  : > "$LOG"
  nohup mvn spring-boot:run -Dspring-boot.run.profiles=dev > "$LOG" 2>&1 &
  for i in $(seq 1 60); do
    if grep -q "Started MonthleyApplication" "$LOG" 2>/dev/null; then
      echo "✓ HIDUP di http://localhost:$PORT  (${i}s)"; return 0
    fi
    if grep -q "APPLICATION FAILED TO START\|BUILD FAILURE" "$LOG" 2>/dev/null; then
      echo "✗ GAGAL — punca:"; echo "---"
      grep -m1 -A 4 "Caused by\|Description:" "$LOG" | head -6
      echo "---"; return 1
    fi
    sleep 1
  done
  echo "⚠️  belum hidup selepas 60s — cuba './mb err'"; return 1
}

# Cipta semula pangkalan data UJIAN dari kosong.
#
# Ujian menggunakan monthley_test, bukan monthley_new, supaya ia boleh
# berjalan sambil backend hidup. Kedua-duanya pada MySQL yang sama.
#
# Skema dibina dengan menjalankan SEMUA migrasi mengikut urutan versi —
# jadi ia turut mengesahkan migrasi boleh membina sistem dari kosong.
testdb() {
  echo "→ mencipta semula monthley_test…"
  mysql -u root -e "DROP DATABASE IF EXISTS monthley_test;
                    CREATE DATABASE monthley_test
                      CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
                    GRANT ALL PRIVILEGES ON monthley_test.* TO 'monthley'@'localhost';
                    FLUSH PRIVILEGES;" || { echo "✗ gagal cipta DB"; return 1; }

  local n=0
  for f in $(ls src/main/resources/db/migration/V*.sql | sort -V); do
    if ! mysql -u root monthley_test < "$f" 2>/tmp/mb-mig.err; then
      echo "✗ $(basename "$f")"; head -3 /tmp/mb-mig.err; return 1
    fi
    n=$((n+1))
  done

  # Sejarah flyway didaftar supaya mvn flyway:migrate tidak cuba semula.
  mysql -u root monthley_test -e "
    CREATE TABLE flyway_schema_history (
      installed_rank INT NOT NULL, version VARCHAR(50),
      description VARCHAR(200) NOT NULL, type VARCHAR(20) NOT NULL,
      script VARCHAR(1000) NOT NULL, checksum INT,
      installed_by VARCHAR(100) NOT NULL,
      installed_on TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
      execution_time INT NOT NULL, success TINYINT(1) NOT NULL,
      PRIMARY KEY (installed_rank), KEY flyway_schema_history_s_idx (success)
    ) ENGINE=InnoDB;"

  local rank=1
  for f in $(ls src/main/resources/db/migration/V*.sql | sort -V); do
    local base ver desc
    base=$(basename "$f" .sql)
    ver=${base%%__*}; ver=${ver#V}
    desc=$(echo "${base#*__}" | tr '_' ' ')
    mysql -u root monthley_test -e "
      INSERT INTO flyway_schema_history
        (installed_rank, version, description, type, script, checksum,
         installed_by, execution_time, success)
      VALUES ($rank, '$ver', '$desc', 'SQL', '$(basename "$f")', NULL,
              'mb-testdb', 0, 1);"
    rank=$((rank+1))
  done

  echo "✓ monthley_test siap — $n migrasi"
}

case "${1:-status}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; mvn -q compile || { echo "✗ compile gagal"; exit 1; }; start ;;
  log)     tail -f "$LOG" ;;
  status)  status ;;
  err)     grep -m3 -B2 -A 8 -iE "Caused by|APPLICATION FAILED|ERROR" "$LOG" | head -40 ;;
  testdb)  testdb ;;
  *)       echo "guna: ./mb {start|stop|restart|log|status|err|testdb}" ;;
esac
